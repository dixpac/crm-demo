#!/usr/bin/env bash
set -euo pipefail

# Install system dependencies (PostgreSQL + native gem extension prereqs + libvips)
# apt-get install is idempotent, so run unconditionally to avoid partial installs.
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
  build-essential curl libpq-dev libvips pkg-config postgresql \
  postgresql-contrib

# Install mise if not already available
if ! command -v mise >/dev/null; then
  curl -fsSL https://mise.run | sh
  export PATH="$HOME/.local/bin:$PATH"
fi
MISE_BIN="$(command -v mise)"

# Activate mise for future interactive shells (using resolved path)
if ! grep -q "$MISE_BIN" "$HOME/.bashrc" 2>/dev/null; then
  echo "eval \"\$($MISE_BIN activate bash)\"" >> "$HOME/.bashrc"
fi

# Install Ruby from mise.toml (binary-only — never fall back to source compilation)
export MISE_RUBY_COMPILE=false
mise install

# Activate mise for the current non-interactive script
eval "$(mise env -s bash)"
ruby --version

# Start PostgreSQL and create a superuser role for the orb user
sudo pg_ctlcluster 15 main start || true
if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '$USER'" | grep -qx 1; then
  sudo -u postgres createuser --superuser "$USER"
fi

bundle check || bundle install
bin/rails db:prepare
