<% content_for :title, "Edit #{@contact.full_name}" %>

<div class="page-header">
  <div>
    <h1>Edit contact</h1>
    <p class="subtitle"><%= @contact.full_name %></p>
  </div>
  <%= link_to "Cancel", @contact, class: "button button-secondary" %>
</div>

<div class="panel form-panel">
  <%= render "form", contact: @contact %>
</div>
